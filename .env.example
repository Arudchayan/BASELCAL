# Optional personal overlay. Never commit real values.
#
# Local: copy config/student.example.json to config/student.local.json
#        (gitignored). Vite loads it automatically for `npm run dev`.
#
# Vercel / CI: paste the same JSON as one line:
# STUDENT_CONFIG={"admissionTarget":28,"seedPlan":true,"plan":{"s1":[],"s2":[],"s3":[],"s4":[]},"home":{"lat":null,"lng":null}}
#
# Tests force a generic build:
# BASELCAL_DISABLE_STUDENT_CONFIG=1
