# Local owner overlay (gitignored). Used only by `npm run dev`.
# cp config/student.example.json config/student.local.json

# Owner UniCal calendar URL (server/local only — never VITE_*).
# On unlock / local seed this replaces Sem 1 with the matched catalog courses.
# Example:
# UNICAL_URL=https://unical.unibas.ch/calendar?e=00302796%2C00302775%2C00301992%2C00302622%2C00301984%2C00301990%2C00302761%2C00302113%2C00303302

# Hosted demo: do NOT bake STUDENT_CONFIG into the Vite client.
# Set these on Vercel as server env vars. /api/unlock returns the overlay after login.
# PLANNER_USER=your-username
# PLANNER_PASSWORD=a-long-secret
# STUDENT_CONFIG={"admissionTarget":28,"seedPlan":true,"plan":{"s1":[],"s2":[],"s3":[],"s4":[]}}
# UNICAL_URL=https://unical.unibas.ch/calendar?e=...

# Tests force a generic build:
# BASELCAL_DISABLE_STUDENT_CONFIG=1
