{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "ignorePatterns": [
    "archive/**",
    "dist/**",
    "node_modules/**",
    "extract.cjs",
    "extract.js",
    "filter.cjs",
    "count.cjs",
    "count_titles.cjs",
    "create_batches.cjs",
    "make_batches.cjs",
    "compile.cjs",
    "compile_logs.cjs",
    "compile_msgs.cjs",
    "parse.cjs",
    "split_course.cjs",
    "dedupe.js",
    "dedupe_json.cjs",
    "write_dedupe.cjs",
    "check.cjs",
    "check_modules.cjs",
    "check_modules2.cjs",
    "check_titles.cjs",
    "find_dupes.cjs",
    "test.cjs",
    "test2.cjs",
    "test_get.cjs",
    "test_scraper.cjs",
    "test_scraper2.cjs",
    "test_scraper3.cjs",
    "test_scraper_analysis.cjs",
    "test_screenshot.cjs",
    "test_screenshot2.cjs",
    "basel_api_test.cjs",
    "workflow_script.cjs",
    "enrich_courses.cjs",
    "append.py",
    "courses.cjs",
    "actual_courses.cjs",
    "audit_cross_source.cjs",
    "audit_actual_data.cjs",
    "verify_live_unibas.cjs",
    "scrape_vv_live.cjs",
    "scrape_and_apply_vv.cjs",
    "scrape_vv_2026.cjs",
    "scrape_preset_schedules.cjs",
    "apply_vv_2026_schedules.cjs",
    "merge_schedules_from_scrape.cjs",
    "merge_real_data.cjs",
    "probe_vv_*.cjs",
    "validate_round2.cjs"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  }
}
