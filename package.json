{
  "name": "unibas-ds-planner",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "Unofficial University of Basel MSc Data Science curriculum planner (ECTS, timetable, Vorlesungsverzeichnis)",
  "homepage": "https://baselcal.vercel.app",
  "bugs": {
    "url": "https://github.com/Arudchayan/BASELCAL/issues"
  },
  "keywords": [
    "university-of-basel",
    "unibas",
    "msc-data-science",
    "curriculum-planner",
    "ects",
    "vorlesungsverzeichnis",
    "timetable"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Arudchayan/BASELCAL.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "validate": "node validate_all.cjs && node validate_details.cjs",
    "validate:details": "node validate_details.cjs",
    "validate:details:live": "node validate_details.cjs --live",
    "validate:details:plan": "node validate_details.cjs --plan",
    "audit:vv": "node vv_msc_ds_official_scrape.cjs",
    "audit:modules": "node scrape_module_manifest.cjs",
    "refresh:modules": "node scrape_module_manifest.cjs --apply",
    "audit:catalog": "node scrape_catalog_details.cjs",
    "refresh:catalog": "node scrape_catalog_details.cjs --apply",
    "test": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "framer-motion": "^12.42.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.23.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
